{
  "expo": {
    "name": "WorldWideSomeone",
    "slug": "worldwidesomeone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wws",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.worldwidesomeone.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.worldwidesomeone.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "편지가 어디서 출발하고, 어떤 편지가 머리 위를 지나는지 알기 위해 위치를 사용해요. 친구에게는 50km 반경으로만 공유돼요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "편지에 사진을 붙이기 위해 사진 보관함에 접근해요."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5C8A"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
