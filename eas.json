{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_FIREBASE_REGION": "asia-northeast3" } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "autoIncrement": true }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "APPLE_ID_EMAIL", "ascAppId": "APP_STORE_CONNECT_APP_ID", "appleTeamId": "TEAM_ID" },
      "android": { "serviceAccountKeyPath": "./google-play-service-account.json", "track": "internal" }
    }
  }
}
